# Copy this file to `.env` and edit values if needed.

# Core app settings
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Optional tuning for production hosting
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=info

SXC_ADMIN_USERNAME=sxcadmin
SXC_ADMIN_PASSWORD=1923

SXC_STAFF_USERNAME=staff
SXC_STAFF_PASSWORD=1923

# Optional: create a sample student account at startup (format: NNDEPNNN)
SXC_SAMPLE_STUDENT=23uma101

# Optional SMTP settings (for request notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
